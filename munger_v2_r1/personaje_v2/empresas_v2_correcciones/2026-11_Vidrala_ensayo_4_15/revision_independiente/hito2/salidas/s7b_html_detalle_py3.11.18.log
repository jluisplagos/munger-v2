python 3.11.18
   comentario sin cerrar                                   '<p>a</p><!-- nota CITA'                                       -> ('ok', ' a ')
   comentario sin cerrar con > dentro                      '<p>a</p><!-- nota > CITA'                                     -> ('ok', ' a ')
   comentario sin cerrar con etiqueta dentro               '<p>a</p><!-- <p>CITA</p>'                                     -> ('ok', ' a ')
   declaración sin cerrar                                  '<p>a</p><!DOCTYPE CITA'                                       -> ('ok', ' a ')
   etiqueta sin cerrar al final                            '<p>a</p><div title="CITA'                                     -> ('ok', ' a ')
   etiqueta sin cerrar con > en atributo                   '<p>a</p><div title="x > CITA'                                 -> ('ok', ' a ')
   script sin cerrar                                       "<p>a</p><script>var x = 'CITA'"                               -> ('ok', ' a  ')
   style sin cerrar                                        "<p>a</p><style>.x{content:'CITA'}"                            -> ('ok', ' a  ')
   textarea sin cerrar                                     '<p>a</p><textarea>CITA'                                       -> ('ok', ' a  ')
   title sin cerrar                                        '<p>a</p><title>CITA'                                          -> ('ok', ' a  ')
   script con </script dentro de cadena                    "<p>a</p><script>var x = '</script>CITA';</script>"            -> ('ok', " a   CITA'; ")
   script con comentario <!-- <script> --> (doble escape)  '<p>a</p><script><!-- <script> </script> CITA --></script><p>b</p>' -> ('ok', ' a    CITA -->  b ')
   CDATA                                                   '<p>a</p><![CDATA[ CITA ]]><p>b</p>'                           -> ('ok', ' a  b ')
   CDATA en svg                                            '<p>a</p><svg><![CDATA[ CITA ]]></svg>'                        -> ('ok', ' a   ')
   plaintext                                               '<p>a</p><plaintext><div hidden>CITA</div>'                    -> ('ok', ' a  <div hidden>CITA</div>')
   iframe con marcado                                      '<p>a</p><iframe><p>CITA</p></iframe><p>b</p>'                 -> ('ok', ' a    b ')
   noscript con marcado                                    '<p>a</p><noscript><p>CITA</p></noscript><p>b</p>'             -> ('ok', ' a      b ')
   entidad sin punto y coma                                '<p>CITA &euro 5 &amp 6 &nbsp7</p>'                            -> ('ok', ' CITA &euro 5 & 6 \xa07 ')
   </p > con espacio                                       '<p hidden>x</p >CITA'                                         -> ('ok', '  CITA')
   </script	>                                              '<script>x</script\t>CITA'                                     -> ('ok', '  CITA')
   etiqueta con salto de línea                             '<p\nhidden\n>x</p>CITA'                                       -> ('ok', '  CITA')
