+          "| Parámetro | Cobertura | Variante | Precio de Sí | Δ € | Δ % | Atribuible |", "|---|---|---|---|---|---|---|"] + filas
+    open(os.path.join(carpeta, "contraste_objetivo_v64.md"), "w", encoding="utf-8").write("\n".join(md) + "\n")
